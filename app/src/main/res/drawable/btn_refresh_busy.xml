<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's Refresh pill while an update is running: tinted so it clearly reads as "busy". -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#338C9EFF" />
    <corners android:radius="16dp" />
    <stroke
        android:width="1dp"
        android:color="#998C9EFF" />
</shape>
